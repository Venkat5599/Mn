# Chain + contracts (copy values from deployments/<chainId>.json)
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_PITCH_ORACLE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PITCHSIDE_ROOMS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STAKE_TOKEN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STAKE_TOKEN_IS_MOCK=true
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Relayer drip endpoint (gas for new room keys)
NEXT_PUBLIC_DRIP_URL=http://localhost:8787

# Optional Envio GraphQL endpoint for season standings and the room feed
NEXT_PUBLIC_INDEXER_URL=

# passkey (default) · passkey-or-device (dev: fall back when the provider has no PRF) · device (local sim, tests)
NEXT_PUBLIC_ACCOUNT_MODE=passkey

# Local simulated game only (bun run dev:local writes this)
NEXT_PUBLIC_MLB_API=
